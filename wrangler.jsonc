{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "datatruth",
  "main": "./worker/entry.js",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ratelimits": [
    { "name": "AUDIT_GLOBAL_LIMIT", "namespace_id": "473011", "simple": { "limit": 10, "period": 60 } },
    { "name": "AUDIT_CLIENT_LIMIT", "namespace_id": "473012", "simple": { "limit": 2, "period": 60 } }
  ],
  "durable_objects": { "bindings": [{ "name": "AUDIT_QUOTA", "class_name": "AuditQuota" }] },
  "migrations": [{ "tag": "audit-quota-v1", "new_sqlite_classes": ["AuditQuota"] }],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
